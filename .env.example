# Copy to .env (or .env.local), or set these in your host (e.g. Vercel). Never commit real values.

# Online rooms over Supabase Realtime. Supabase → Project Settings → API.
# The publishable (anon) key is public by design. Never put the secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Or, without Supabase: the relay server in server/ (default ws://<host>:8787).
VITE_SERVER_URL=

# Test account for trying every pen and power (see src/profile/tester.ts). Leave unset for no test login.
VITE_TESTER_USER=
VITE_TESTER_PASSCODE=
